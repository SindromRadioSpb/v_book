          "lemma_phrase": "מדעי חדש נגיף",
          "pos_pattern": ["ADJ", "ADJ", "NOUN"]
        }
      ],
      "expected_count": 1,
      "notes": "NOUN+ADJ+ADJ is not in VALID_POS_PATTERNS — only ADJ+ADJ+NOUN is valid"
    }
  ]
