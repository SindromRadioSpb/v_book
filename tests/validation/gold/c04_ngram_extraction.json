{
  "corpus_id": "C04",
  "description": "N-gram extraction gold standard. Inputs are pre-tokenized (no Stanza required).",
  "notes": "VALID_POS_PATTERNS for bigrams: (NOUN,NOUN),(NOUN,ADJ),(ADJ,NOUN),(PROPN,PROPN),(NUM,NOUN). For trigrams: (NOUN,NOUN,NOUN),(NOUN,ADJ,NOUN),(ADJ,ADJ,NOUN). N-grams use sliding window within sentence. merge_standalone_articles may alter tokens before matching.",
  "cases": [
    {
      "case_id": "C04_01",
      "description": "NOUN+NOUN bigram (construct chain) — ספר לימוד (textbook)",
      "input": {
        "tokens": [
          {"text": "ספר", "lemma": "ספר", "pos": "NOUN"},
          {"text": "לימוד", "lemma": "לימוד", "pos": "NOUN"}
        ],
        "n_values": [2]
      },
      "expected_ngrams": [
        {
          "n": 2,
          "surface_text": "ספר לימוד",
          "lemma_phrase": "ספר לימוד",
          "pos_pattern": ["NOUN", "NOUN"]
        }
      ],
      "expected_count": 1
    },
    {
      "case_id": "C04_02",
      "description": "NOUN+ADJ bigram — ילד גדול (big boy)",
      "input": {
        "tokens": [
          {"text": "ילד", "lemma": "ילד", "pos": "NOUN"},
          {"text": "גדול", "lemma": "גדול", "pos": "ADJ"}
        ],
        "n_values": [2]
      },
      "expected_ngrams": [
        {
          "n": 2,
          "surface_text": "ילד גדול",
          "lemma_phrase": "ילד גדול",
          "pos_pattern": ["NOUN", "ADJ"]
        }
      ],
      "expected_count": 1
    },
    {
      "case_id": "C04_03",
      "description": "ADJ+NOUN bigram — גדול עיר (big city, though unusual order)",
      "input": {
        "tokens": [
          {"text": "גדול", "lemma": "גדול", "pos": "ADJ"},
          {"text": "עיר", "lemma": "עיר", "pos": "NOUN"}
        ],
        "n_values": [2]
      },
      "expected_ngrams": [
        {
          "n": 2,
          "surface_text": "גדול עיר",
          "lemma_phrase": "גדול עיר",
          "pos_pattern": ["ADJ", "NOUN"]
        }
      ],
      "expected_count": 1
    },
    {
      "case_id": "C04_04",
      "description": "PROPN+PROPN bigram — מדינת ישראל (State of Israel)",
      "input": {
        "tokens": [
          {"text": "מדינת", "lemma": "מדינה", "pos": "PROPN"},
          {"text": "ישראל", "lemma": "ישראל", "pos": "PROPN"}
