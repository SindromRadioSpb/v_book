        "n_values": [2]
      },
      "expected_ngrams": [
        {
          "n": 2,
          "surface_text": "מדינת ישראל",
          "lemma_phrase": "מדינה ישראל",
          "pos_pattern": ["PROPN", "PROPN"]
        }
      ],
      "expected_count": 1
    },
    {
      "case_id": "C04_05",
      "description": "NUM+NOUN bigram — שלוש שנים (three years)",
      "input": {
        "tokens": [
          {"text": "שלוש", "lemma": "שלוש", "pos": "NUM"},
          {"text": "שנים", "lemma": "שנה", "pos": "NOUN"}
