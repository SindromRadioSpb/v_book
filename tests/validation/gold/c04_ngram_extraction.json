      "input": {
        "tokens": [
          {"text": "מחקר", "lemma": "מחקר", "pos": "NOUN"},
          {"text": "מדעי", "lemma": "מדעי", "pos": "ADJ"},
          {"text": "חדש", "lemma": "חדש", "pos": "ADJ"},
          {"text": "נגיף", "lemma": "נגיף", "pos": "NOUN"}
        ],
        "n_values": [3]
